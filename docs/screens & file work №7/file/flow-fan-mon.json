[
 {
  "id": "589ac32a3bbd7e7d",
  "type": "tab",
  "label": "Умный офис: датчики и вентилятор",
  "disabled": false,
  "info": "Отчёт №7: TEMP-01 и HUM-01 отправляются каждые 5 секунд на CTRL-01 (receiver v3 с /metrics) и на DB-01:8081 (SQLite). Вентилятор FAN-01 работает по прежней логике: температура больше 30 -> ON, иначе OFF. Для проверки оповещений уберите Repeat у нужного inject и нажмите Deploy."
 },
